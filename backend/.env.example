# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit real secrets.

# Only needed when deploying somewhere other than local dev (Railway, etc.) —
# local dev falls back to the hardcoded default in config.py otherwise.
# Railway's MySQL plugin gives you this connection info directly; reshape it
# into mysql+pymysql://user:password@host:port/dbname.
# DATABASE_URL=mysql+pymysql://user:password@host:port/dbname

# Only needed when deploying — local dev uses the default in config.py.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Comma-separated list of allowed frontend origins. Local dev has its own
# hardcoded defaults (localhost:8081 etc.) in main.py — only set this when
# deploying, to the real deployed frontend URL(s), e.g.:
# CORS_ORIGINS=https://your-app.vercel.app

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:8081

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=

# Get a free key at https://aistudio.google.com — used only for Assistive
# Document Extraction (pre-filling a certificate number from the uploaded
# image). Blank is fine; the feature just no-ops without one.
GEMINI_API_KEY=
